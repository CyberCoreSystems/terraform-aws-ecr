# ==============================================================================
#  aws-ecr — terraform.tfvars
# ==============================================================================
#  Copy this file to `terraform.tfvars`, set the values, then run:
#      tofu init && tofu apply        (or:  terraform init && terraform apply)
#
# AUTHENTICATION — AWS:
#   The AWS provider authenticates exactly like the AWS SDK/CLI, resolving
#   credentials through a fixed precedence chain and (separately) requiring a
#   region.
#   Quick start: aws sso login --profile <name> (or `aws configure sso`
#   first-time setup; `aws configure` for static keys). The SDK/Terraform read
#   the SSO/credential cache automatically.
#   Environment variables Terraform reads:
#     AWS_ACCESS_KEY_ID  (secret) — Access key ID for static/temporary credentials.
#     AWS_SECRET_ACCESS_KEY  (secret) — Secret access key paired with the access key ID.
#     AWS_SESSION_TOKEN  (secret) — Session token for temporary (STS) credentials.
#     AWS_REGION — Target AWS region (required); preferred over AWS_DEFAULT_REGION.
#     AWS_DEFAULT_REGION — Legacy region variable; used if AWS_REGION is unset.
#   Full guide (auth + remote state):  docs/CONNECTING-PROVIDERS.md#aws
#
#  Secrets below read "REPLACE_ME" — never commit real secrets. Prefer
#  TF_VAR_<name> environment variables or a secrets manager.
#  Status: static-validated, live-test pending (see README.md).
# ==============================================================================


# ------------------------------------------------------------------------------
#  REQUIRED — you must set these
# ------------------------------------------------------------------------------

# repository_name  —  string  (REQUIRED)
#   Repository name. May include namespaces (e.g. "team/app"). Lowercase
#   letters, digits and single ._/- separators.
#   Constraint: repository_name must be 2-256 characters of lowercase letters
#   and digits, separated by single '.', '_', '/' or '-' characters.
repository_name = "iacbazaar/example-app"

# ------------------------------------------------------------------------------
#  OPTIONAL — defaults shown; uncomment a line to override
# ------------------------------------------------------------------------------

# image_tag_mutability  —  string  (optional, default: "IMMUTABLE")
#   Tag mutability. IMMUTABLE (default) prevents tags from being overwritten —
#   strongly recommended for supply-chain integrity.
#   Constraint: image_tag_mutability must be IMMUTABLE or MUTABLE.
# image_tag_mutability = "IMMUTABLE"

# scan_on_push  —  bool  (optional, default: true)
#   Run a basic vulnerability scan on every pushed image.
# scan_on_push = true

# force_delete  —  bool  (optional, default: false)
#   Allow Terraform to destroy the repository even when it still contains
#   images. Keep false in production; set true in ephemeral/test environments.
force_delete = true

# kms_key_arn  —  string  (optional, default: null)
#   KMS key ARN for at-rest encryption. null uses AES256 (images are always
#   encrypted either way).
# kms_key_arn = null

# untagged_expiry_days  —  number  (optional, default: 14)
#   Expire untagged images (superseded layers, failed pushes) after this many
#   days. 0 disables the rule.
#   Constraint: untagged_expiry_days must be between 0 and 3650.
untagged_expiry_days = 7

# tagged_image_retention  —  list  (optional, default: [])
#   Keep-last-N presets for tagged images, one rule per entry (e.g. keep the
#   last 30 images whose tags start with "v").
#   Constraint: Every tagged_image_retention entry needs keep_count >= 1 and at
#   least one tag prefix.
tagged_image_retention = [
  {
    tag_prefixes = ["v"]
    keep_count   = 30
  },
]

# max_image_count  —  number  (optional, default: 0)
#   Hard cap on total images in the repository (applied after the other rules).
#   0 disables the rule.
#   Constraint: max_image_count must be >= 0.
max_image_count      = 100

# lifecycle_policy  —  string  (optional, default: null)
#   Full lifecycle-policy JSON. Overrides all preset rules
#   (untagged_expiry_days, tagged_image_retention, max_image_count) when set.
# lifecycle_policy = null

# pull_principal_arns  —  list  (optional, default: [])
#   IAM principal ARNs (other accounts, roles) granted read-only pull access.
pull_principal_arns = ["arn:aws:iam::123456789012:root"]

# push_principal_arns  —  list  (optional, default: [])
#   IAM principal ARNs granted push (and pull) access — e.g. a CI/CD role in a
#   build account.
# push_principal_arns = []

# allow_lambda_pull  —  bool  (optional, default: false)
#   Allow the Lambda service to pull images for container-image functions in
#   this account.
# allow_lambda_pull = false

# repository_policy  —  string  (optional, default: null)
#   Full repository-policy JSON. Overrides pull/push/Lambda preset statements
#   when set.
# repository_policy = null

# replication_destinations  —  list  (optional, default: [])
#   Cross-region replication destinations. registry_id defaults to the current
#   account. NOTE: replication configuration is account-wide — enable it from
#   one place only.
#   Constraint: Every replication destination region must look like an AWS
#   region (e.g. eu-west-1).
# replication_destinations = []

# replication_repository_filters  —  list  (optional, default: null)
#   Repository-name prefix filters for replication. null (default) replicates
#   only this repository; an explicit empty list replicates the whole registry.
# replication_repository_filters = null

# tags  —  map  (optional, default: {})
#   Tags applied to all resources.
tags = {
  Environment = "example"
  ManagedBy   = "iac-bazaar"
}
